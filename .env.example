# Host-facing web port
STUDYTUBE_PORT=3000

# Access control. StudyTube fails closed until a password is configured.
# Generate a strong password, for example: openssl rand -base64 32
STUDYTUBE_AUTH_USER=admin
STUDYTUBE_AUTH_PASSWORD=

# Persistent host directories. For Unraid, keep these on appdata/cache-backed storage.
STUDYTUBE_DATA_PATH=/mnt/user/appdata/studytube/data
PIPER_DATA_PATH=/mnt/user/appdata/studytube/piper
OMNIVOICE_DATA_PATH=/mnt/user/appdata/studytube/omnivoice
CHATTERBOX_DATA_PATH=/mnt/user/appdata/studytube/chatterbox
XTTS_DATA_PATH=/mnt/user/appdata/studytube/xtts
STUDYTUBE_CREDENTIALS_PATH=/mnt/user/appdata/studytube/credentials

# Remotion render limits. Lower concurrency reduces CPU/RAM pressure on home servers.
STUDYTUBE_RENDER_CONCURRENCY=2
STUDYTUBE_RENDER_TIMEOUT_MS=120000

# Narration defaults. Every engine starts with a normal `docker compose up -d --build`.
# The render UI selects a provider and overrides its settings per job.
STUDYTUBE_TTS_PROVIDER=edge

# Edge TTS: lightweight, online, no API key.
EDGE_TTS_VOICE=nl-NL-MaartenNeural
EDGE_TTS_RATE=+0%

# Piper: local/offline and lightweight.
PIPER_VOICE=nl_NL-mls-medium
PIPER_LENGTH_SCALE=1

# OmniVoice: local, multilingual, lazy-loaded on first use.
OMNIVOICE_DEVICE=cpu
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_SPEED=1
OMNIVOICE_NUM_STEPS=16
OMNIVOICE_NORMALIZE_TEXT=true

# Chatterbox Multilingual: local, lazy-loaded. V2 is the safer default; V3 remains selectable in the UI.
CHATTERBOX_DEVICE=cpu
CHATTERBOX_T3_MODEL=v2
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_TEMPERATURE=0.8

# XTTS v2: local, lazy-loaded. The model uses the Coqui Public Model License.
# Leave this at 0 until you have read and explicitly accepted https://coqui.ai/cpml
COQUI_TOS_AGREED=0
XTTS_DEVICE=cpu
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_SPEAKER=Ana Florence
XTTS_SPEED=1

# Google Cloud Chirp 3 HD. Put Google ADC/service-account credentials at:
# ${STUDYTUBE_CREDENTIALS_PATH}/google.json
# Google Cloud billing still needs to be enabled even when usage remains in the free tier.
GOOGLE_CHIRP_VOICE=nl-NL-Chirp3-HD-Charon

# Azure Speech. Leave blank if you do not want to configure Azure yet.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_TTS_VOICE=nl-NL-MaartenNeural
