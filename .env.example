# Host-facing web port
STUDYTUBE_PORT=3000

# Persistent host directories. For Unraid, keep these on appdata/cache-backed storage.
STUDYTUBE_DATA_PATH=/mnt/user/appdata/studytube/data
PIPER_DATA_PATH=/mnt/user/appdata/studytube/piper
OMNIVOICE_DATA_PATH=/mnt/user/appdata/studytube/omnivoice

# Remotion render limits. Lower concurrency reduces CPU/RAM pressure on home servers.
STUDYTUBE_RENDER_CONCURRENCY=2
STUDYTUBE_RENDER_TIMEOUT_MS=120000

# Narration defaults. The render UI can override the provider and its settings per job.
# Edge TTS is the default high-quality neural voice and requires internet access.
STUDYTUBE_TTS_PROVIDER=edge
EDGE_TTS_VOICE=nl-NL-MaartenNeural
EDGE_TTS_RATE=+0%

# Offline Piper fallback (start Compose with --profile offline-tts)
PIPER_VOICE=nl_NL-mls-medium
PIPER_LENGTH_SCALE=1

# Experimental local OmniVoice (start Compose with --profile omnivoice)
# CPU is compatible but substantially slower than a supported GPU. 16 steps favors test speed.
OMNIVOICE_DEVICE=cpu
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_SPEED=1
OMNIVOICE_NUM_STEPS=16
OMNIVOICE_NORMALIZE_TEXT=true
