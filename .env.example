# Host-facing web port
STUDYTUBE_PORT=3000

# Persistent host directories. For Unraid, keep these on appdata/cache-backed storage.
STUDYTUBE_DATA_PATH=/mnt/user/appdata/studytube/data
PIPER_DATA_PATH=/mnt/user/appdata/studytube/piper

# Remotion render limits. Lower concurrency reduces CPU/RAM pressure on home servers.
STUDYTUBE_RENDER_CONCURRENCY=2
STUDYTUBE_RENDER_TIMEOUT_MS=120000

# Local Dutch narration
PIPER_VOICE=nl_NL-mls-medium
PIPER_LENGTH_SCALE=1
